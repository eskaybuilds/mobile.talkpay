{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "jsx": "react-native",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "rootDir": ".",
    "types": ["jest", "node"],
    "paths": {
      "@talkpay/shared/utils/app-env": ["./libs/shared/utils/app-env/src/index.ts"],
      "@talkpay/shared/ui/styles": ["./libs/shared/ui/styles/src/index.ts"],
      "@talkpay/shared/ui/ui-kit": ["./libs/shared/ui/ui-kit/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
