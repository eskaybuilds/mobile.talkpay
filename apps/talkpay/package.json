{
  "name": "talkpay",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "dotenv -e ../../.env.development -- expo start --dev-client",
    "start:staging": "dotenv -e ../../.env.staging -- expo start --dev-client",
    "ios": "dotenv -e ../../.env.development -- expo run:ios",
    "android": "dotenv -e ../../.env.development -- expo run:android",
    "prebuild": "dotenv -e ../../.env.development -- expo prebuild",
    "build:debug": "node ../../tools/scripts/eas-sync-and-build.mjs --profile=debug --env=development -p all",
    "build:internal": "node ../../tools/scripts/eas-sync-and-build.mjs --profile=internal --env=development -p all",
    "build:staging": "node ../../tools/scripts/eas-sync-and-build.mjs --profile=staging -p all",
    "build:prod": "node ../../tools/scripts/eas-sync-and-build.mjs --profile=production -p all",
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/talkpay"
  },
  "dependencies": {
    "@eskaybuilds/secure-auth": "*",
    "@expo/metro-config": "*",
    "@expo/metro-runtime": "*",
    "@tanstack/query-sync-storage-persister": "*",
    "@tanstack/react-query": "*",
    "@tanstack/react-query-persist-client": "*",
    "expo": "*",
    "expo-constants": "*",
    "expo-dev-client": "*",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "react": "*",
    "react-native": "*",
    "react-native-edge-to-edge": "*",
    "react-native-mmkv": "*",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-svg": "*",
    "react-native-unistyles": "*",
    "react-native-worklets": "*",
    "zod": "*"
  }
}
